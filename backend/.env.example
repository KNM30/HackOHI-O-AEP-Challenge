# Optional AI explanations for the assistant panel. Without these the assistant gives
# deterministic, clearly labelled standard answers. Copy to backend/.env (git-ignored)
# and never commit real keys.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional overrides (defaults shown)
AI_MODEL=claude-haiku-5-5
AI_EFFORT=low
AI_TIMEOUT_S=15
AI_MAX_RETRIES=1
AI_MAX_TOKENS=2000
